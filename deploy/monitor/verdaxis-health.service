[Unit]
Description=Verdaxis credential-free local readiness monitor
After=verdaxis-backend.service verdaxis-backend-staging.service
OnFailure=verdaxis-monitor-alert@health-failure.service
OnSuccess=verdaxis-monitor-alert@health-healthy.service

[Service]
Type=oneshot
User=verdaxis-health
Group=verdaxis-health
ExecStart=/usr/bin/python3 /usr/local/libexec/verdaxis-monitor/local_health_check.py --status-file /var/lib/verdaxis-health/status.json --production-identity-file /etc/verdaxis-monitor/runtime-identities/production.identity --staging-identity-file /etc/verdaxis-monitor/runtime-identities/staging.identity
StateDirectory=verdaxis-health
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=30s
MemoryMax=64M
TasksMax=16
Nice=10

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
