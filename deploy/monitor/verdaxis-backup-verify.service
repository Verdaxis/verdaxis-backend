[Unit]
Description=Verify Verdaxis local backup artifacts without credentials
OnFailure=verdaxis-monitor-alert@backup-failure.service
OnSuccess=verdaxis-monitor-alert@backup-healthy.service

[Service]
Type=oneshot
User=verdaxis-backup-reader
Group=verdaxis-backup-readers
ExecStart=/usr/bin/python3 /usr/local/libexec/verdaxis-monitor/backup_verify.py --backup-status /home/verdaxis-prod/backups/status.json --backup-directory /home/verdaxis-prod/backups --attempt-directory /home/verdaxis-prod/backups/attempts --output /var/lib/verdaxis-backup-verify/status.json
StateDirectory=verdaxis-backup-verify
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=180s
MemoryMax=128M
TasksMax=16
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/verdaxis-prod/backups
InaccessiblePaths=/home/verdaxis-prod/.backup-env /home/verdaxis-prod/verdaxis
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
