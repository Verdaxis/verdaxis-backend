[Unit]
Description=Generate disclosed Verdaxis staging demo market activity
ConditionPathExists=!/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy/staging.state
After=postgresql.service verdaxis-backend-staging.service
Wants=postgresql.service

[Service]
Type=oneshot
User=verdaxis-demo-staging
Group=verdaxis-demo-staging
WorkingDirectory=/home/verdaxis-prod/verdaxis/staging/be
RuntimeDirectory=verdaxis-demo-staging
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/verdaxis-monitor/demo/staging.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.runtime-release.env
Environment=ENVIRONMENT=staging
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env ENVIRONMENT=staging /usr/bin/python3 /usr/local/libexec/verdaxis-monitor/verify_runtime_identity.py --source-directory /home/verdaxis-prod/verdaxis/staging/be --expected-environment staging --expected-release-sha ${RELEASE_SHA} --python-executable /home/verdaxis-prod/verdaxis/staging/be/venv/bin/python --script scripts/run_demo_activity.py --runtime-directory %t/verdaxis-demo-staging
UMask=0077
TimeoutStartSec=600s
MemoryMax=512M
TasksMax=64
Nice=10

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/verdaxis-prod/verdaxis/staging/be
InaccessiblePaths=/home/verdaxis-prod/verdaxis/staging/be/.env
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1
