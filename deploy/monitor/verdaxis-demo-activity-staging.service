[Unit]
Description=Generate disclosed Verdaxis staging demo market activity
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service
RequiresMountsFor=/home/verdaxis-prod/verdaxis/staging/be
ConditionPathExists=!/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy/staging.state
ConditionPathIsSymbolicLink=!/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy/staging.state
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/staging/be
# Only this job's projected keys (ops prepare-runtime) reach the process;
# the secret-rich .env is never loaded. The binary runs the identity,
# deploy-state and target gates itself before any work.
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/jobs/demo.env
Environment=DEPLOY_STATE_DIR=/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy
ExecStart=/usr/bin/env /home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/verdaxis-read job demo --environment staging --release-sha ${RELEASE_SHA} --apply
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=30s
# A usage or precondition refusal (for example a live deploy) is not retried.
RestartPreventExitStatus=2 3
# The demo job reaches only the local database and reads only the
# backend folder (the binary and its projected job file): keep the demo
# unit's stricter sandbox, not only the common job baseline.
UMask=0077
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/verdaxis-prod/verdaxis/staging/be
InaccessiblePaths=/home/verdaxis-prod/verdaxis/staging/be/.env
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1
TimeoutStartSec=600s
