# Example only. Copy to /etc/verdaxis-monitor.env with root-only permissions.
# No credentials are supplied here. Replace placeholder paths and values.
STATE_FILE=/var/lib/verdaxis-monitor/state.json
STATUS_FILE=/var/lib/verdaxis-monitor/status.json
CADDYFILE=/etc/caddy/Caddyfile
MIN_CADDYFILE_BYTES=20000
ALERT_COOLDOWN_SECONDS=3600
HTTP_RETRIES=3
HTTP_RETRY_DELAY_SECONDS=2
HTTP_TIMEOUT_SECONDS=15
FRONTEND_BUNDLE_CHECKS_ENABLED=1
RENDERED_PAGE_CHECKS_ENABLED=1
CHROMEDRIVER_BIN=/usr/bin/chromedriver
CHROMIUM_PROFILE_PARENT=/var/lib/verdaxis-render
# This account must exist, must not be root, and must own its home.
RENDER_USER=verdaxis-render
HOME=/root
LANG=C.UTF-8
LC_ALL=C.UTF-8
RENDER_TIMEOUT_SECONDS=75
RENDER_RETRIES=3
RENDER_RETRY_DELAY_SECONDS=2
SIGNUP_CANARY_ENABLED=1
DEMO_TRADE_CANARY_ENABLED=1
SIGNUP_CANARY_TARGETS=example=https://api.example.invalid/api
MONITOR_TOKEN=REPLACE_WITH_MONITOR_TOKEN
BACKUP_STATUS_FILE=/example/backups/status.json
BACKUP_MAX_AGE_SECONDS=108000
ANALYTICS_DATA_DIR=/example/analytics/data
ANALYTICS_MAX_DATA_BYTES=5368709120
MIN_DISK_FREE_PERCENT=10
EXPENSIVE_CHECK_INTERVAL_SECONDS=1800
TELEGRAM_DISABLED=1
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
TELEGRAM_API_BASE=https://api.example.invalid
HEALTHCHECKS_PING_URL=https://healthchecks.example.invalid/REPLACE_WITH_ID
