{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "severity",
    "confidence",
    "summary",
    "likely_root_cause",
    "evidence",
    "recommended_next_steps",
    "requires_human_review"
  ],
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "frontend_release",
        "backend_runtime",
        "database",
        "dns_tls",
        "caddy",
        "backup",
        "capacity",
        "canary_or_monitor",
        "external_provider",
        "unknown"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["warning", "degraded", "outage"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "likely_root_cause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evidence": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "requires_human_review": {
      "type": "boolean"
    }
  }
}
