[Unit]
Description=Bounded automatic recovery for a Verdaxis monitor failure
Wants=network-online.target
After=network-online.target
OnFailure=verdaxis-codex-diagnose.service
OnFailureJobMode=replace

[Service]
Type=oneshot
User=root
Group=jons-openclaw
EnvironmentFile=-/etc/verdaxis-monitor.env
ExecStart=/usr/local/sbin/verdaxis-recover
StateDirectory=verdaxis-recovery
StateDirectoryMode=0750
TimeoutStartSec=20min
UMask=0077
MemoryMax=256M
TasksMax=64
LimitNOFILE=512

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/verdaxis-monitor
ReadWritePaths=/var/lib/verdaxis-recovery
InaccessiblePaths=-/etc/verdaxis-monitor.env
InaccessiblePaths=-/home/jons-openclaw/.ssh
InaccessiblePaths=-/home/jons-openclaw/.config/gh
InaccessiblePaths=-/home/jons-openclaw/.config/vercel
InaccessiblePaths=-/home/verdaxis-prod/.ssh
InaccessiblePaths=-/home/verdaxis-prod/verdaxis/prod/be/.env
InaccessiblePaths=-/home/verdaxis-prod/verdaxis/staging/be/.env
InaccessiblePaths=-/home/verdaxis-prod/.backup-env
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/run/docker.sock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
