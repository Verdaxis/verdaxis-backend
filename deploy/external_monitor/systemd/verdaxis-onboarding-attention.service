[Unit]
Description=Verdaxis production onboarding attention monitor
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/prod/be
# Only this purpose's projected keys (ops prepare-runtime; monitor.onboarding)
# reach the process; the secret-rich .env is never loaded. Telegram keys are
# monitor-owned in /etc/verdaxis-monitor.env. The binary runs the identity,
# deploy-state and target gates itself before any work.
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/jobs/monitor-onboarding.env
Environment=DEPLOY_STATE_DIR=/home/verdaxis-prod/verdaxis/prod/be/.runtime-deploy
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
EnvironmentFile=-/etc/verdaxis-monitor.env
ExecStart=/usr/bin/env /home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/verdaxis-read monitor onboarding --environment production --release-sha ${RELEASE_SHA} --state-file /var/lib/verdaxis-onboarding-attention/state.json
StateDirectory=verdaxis-onboarding-attention
StateDirectoryMode=0700
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/verdaxis-prod/verdaxis/prod/be
ReadWritePaths=/var/lib/verdaxis-onboarding-attention
InaccessiblePaths=/home/verdaxis-prod/verdaxis/prod/be/.env
InaccessiblePaths=-/home/verdaxis-prod/.ssh
InaccessiblePaths=-/home/jons-openclaw/.ssh
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/run/docker.sock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
