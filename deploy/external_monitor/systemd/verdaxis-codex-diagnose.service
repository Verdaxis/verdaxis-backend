[Unit]
Description=Read-only Codex diagnosis for a Verdaxis monitor failure
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/verdaxis-monitor/status.json

[Service]
Type=oneshot
User=jons-openclaw
Group=jons-openclaw
SupplementaryGroups=systemd-journal verdaxis-prod
EnvironmentFile=-/etc/verdaxis-monitor.env
Environment=CODEX_HOME=/var/lib/verdaxis-autodiag/codex-home
ExecStart=/usr/local/sbin/verdaxis-codex-diagnose
StateDirectory=verdaxis-autodiag
StateDirectoryMode=0700
TimeoutStartSec=12min
UMask=0077
MemoryMax=1G
TasksMax=256
LimitNOFILE=1024

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/etc/verdaxis-monitor.env
InaccessiblePaths=-/home/jons-openclaw/.ssh
InaccessiblePaths=-/home/jons-openclaw/.config/gh
InaccessiblePaths=-/home/jons-openclaw/.config/vercel
InaccessiblePaths=-/home/jons-openclaw/.local/share/com.vercel.cli
InaccessiblePaths=-/home/jons-openclaw/.netrc
InaccessiblePaths=-/home/verdaxis-prod/.ssh
InaccessiblePaths=-/home/verdaxis-prod/verdaxis/prod/be/.env
InaccessiblePaths=-/home/verdaxis-prod/verdaxis/staging/be/.env
InaccessiblePaths=-/home/verdaxis-prod/backups/.backup-env
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/run/docker.sock
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
