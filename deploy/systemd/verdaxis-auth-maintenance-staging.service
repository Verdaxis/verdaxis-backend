[Unit]
Description=Verdaxis bounded authentication maintenance (staging)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy/staging.state

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/staging/be
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.runtime-release.env
Environment=ENVIRONMENT=staging
# EnvironmentFile= overrides Environment=; verify the effective runtime identity.
ExecStartPre=/usr/bin/test ${ENVIRONMENT} = staging
ExecStart=/home/verdaxis-prod/verdaxis/staging/be/venv/bin/python -m app.cli.auth_maintenance --batch-size 1000
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
