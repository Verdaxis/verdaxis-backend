[Unit]
Description=Prune Verdaxis product analytics login-day facts (800-date retention, prod)
Documentation=file:/home/verdaxis-prod/verdaxis/prod/fe/docs/product-analytics-runbook.md
After=network-online.target

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/prod/be
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
ExecStartPre=/usr/bin/test -r /home/verdaxis-prod/verdaxis/prod/be/.env
ExecStartPre=/usr/bin/test -r /home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
ExecStart=/home/verdaxis-prod/verdaxis/prod/be/venv/bin/python scripts/prune_product_analytics.py --environment production --release-sha ${RELEASE_SHA}
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
