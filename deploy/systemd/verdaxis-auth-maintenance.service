[Unit]
Description=Verdaxis bounded authentication maintenance (production)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/verdaxis-prod/verdaxis/prod/be/.runtime-deploy/production.state

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/prod/be
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
Environment=ENVIRONMENT=production
# EnvironmentFile= overrides Environment=; verify the effective runtime identity.
ExecStartPre=/usr/bin/test ${ENVIRONMENT} = production
ExecStart=/home/verdaxis-prod/verdaxis/prod/be/venv/bin/python -m app.cli.auth_maintenance --batch-size 1000
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=300
