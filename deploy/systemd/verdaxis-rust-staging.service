[Unit]
Description=Verdaxis Rust public reads (staging)
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service
RequiresMountsFor=/home/verdaxis-prod/verdaxis/staging/be
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Key source must be regular root:root 0400; use an empty placeholder without a key ring.
LoadCredential=kyc-document-keys:/etc/verdaxis/kyc-document-keys-staging.json
Type=simple
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/staging/be
# Identity from the release artifact, then the app-only Rust runtime file the
# deploy transaction projects (ENVIRONMENT, RELEASE_SHA, MIGRATION_REVISION,
# DATABASE_URL, DB_SESSION_TIME_ZONE, KYC_EXECUTION_GATE_ENABLED). The
# secret-rich .env is never loaded: mail, JWT, provider and migrator
# credentials stay out of this long-running process.
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.runtime-release.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/runtime.env
ExecStartPre=/usr/bin/env -i /usr/bin/python3 -I -S -B /home/verdaxis-prod/verdaxis/staging/be/scripts/verify_deploy_start_guard.py --environment staging --expected-release-sha ${RELEASE_SHA}
ExecStartPre=/usr/bin/env -i /usr/bin/python3 -I -S -B /home/verdaxis-prod/verdaxis/staging/be/scripts/verify_rust_start.py --expected-release-sha ${RELEASE_SHA} --budget-file /home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/budget.json --expected-revision ${MIGRATION_REVISION} --revision-file /home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/revision.json
# env exists before the first artifact, so policy-off bootstrap verification
# needs no Rust binary. It preserves the environment and execs in the same PID.
ExecStart=/usr/bin/env /home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/verdaxis-read --bind 127.0.0.1:8011 --budget-file /home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/budget.json
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
TimeoutStartSec=120
LimitNOFILE=65536
TasksMax=256
MemoryHigh=192M
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
