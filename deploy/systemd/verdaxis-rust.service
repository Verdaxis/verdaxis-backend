[Unit]
Description=Verdaxis Rust public reads (production)
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service
RequiresMountsFor=/home/verdaxis-prod/verdaxis/prod/be
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Key source must be regular root:root 0400; use an empty placeholder without a key ring.
LoadCredential=kyc-document-keys:/etc/verdaxis/kyc-document-keys.json
Type=simple
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/prod/be
# Only deploy-written identity and app database credentials reach the process.
# Migrator-backed revision and budget checks remain short-lived prestarts.
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/runtime.env
# Both prestarts run without the runtime environment. The shell guard
# needs no Rust artifact; env launches the binary in the same PID, so
# unit verification passes before the first artifact exists.
ExecStartPre=/usr/bin/env -i PATH=/usr/bin:/bin /bin/bash /home/verdaxis-prod/verdaxis/prod/be/deploy/scripts/verify-deploy-start-guard.sh --environment production --expected-release-sha ${RELEASE_SHA}
ExecStartPre=/usr/bin/env -i /home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/verdaxis-read guard rust-start --expected-release-sha ${RELEASE_SHA} --budget-file /home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/budget.json --expected-revision ${MIGRATION_REVISION} --revision-file /home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/revision.json
ExecStart=/usr/bin/env /home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/verdaxis-read serve --bind 127.0.0.1:8010 --budget-file /home/verdaxis-prod/verdaxis/prod/be/.runtime-rust/budget.json
Restart=on-failure
RestartSec=5
# The service signals systemd only while /health/live answers; a hung
# process misses the keepalives and is restarted (Restart=on-failure).
WatchdogSec=30s
NotifyAccess=main
KillSignal=SIGTERM
TimeoutStopSec=30
TimeoutStartSec=120
LimitNOFILE=65536
TasksMax=256
MemoryHigh=192M
MemoryMax=256M
# At most one of the EU host's four CPUs; PostgreSQL keeps priority.
CPUQuota=100%
CPUWeight=50
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
