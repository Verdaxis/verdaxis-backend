[Unit]
Description=Prune Verdaxis product analytics login-day facts (800-date retention, staging)
Documentation=file:/home/verdaxis-prod/verdaxis/staging/fe/docs/product-analytics-runbook.md
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service
RequiresMountsFor=/home/verdaxis-prod/verdaxis/staging/be
ConditionPathExists=!/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy/staging.state
ConditionPathIsSymbolicLink=!/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy/staging.state
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/staging/be
# Only this job's projected keys (ops prepare-runtime) reach the process;
# the secret-rich .env is never loaded. The binary runs the identity,
# deploy-state and target gates itself before any work.
EnvironmentFile=/home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/jobs/prune-analytics.env
Environment=DEPLOY_STATE_DIR=/home/verdaxis-prod/verdaxis/staging/be/.runtime-deploy
ExecStart=/usr/bin/env /home/verdaxis-prod/verdaxis/staging/be/.runtime-rust/verdaxis-read job prune-analytics --environment staging --release-sha ${RELEASE_SHA} --apply
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=30s
# A usage or precondition refusal (for example a live deploy) is not retried.
RestartPreventExitStatus=2 3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TimeoutStartSec=300
