[Unit]
Description=Verdaxis news refresh (production)
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service
RequiresMountsFor=/home/verdaxis-prod/verdaxis/prod/be

[Service]
Type=oneshot
User=verdaxis-prod
Group=verdaxis-prod
WorkingDirectory=/home/verdaxis-prod/verdaxis/prod/be
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.env
EnvironmentFile=/home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
ExecStartPre=/usr/bin/test -r /home/verdaxis-prod/verdaxis/prod/be/.env
ExecStartPre=/usr/bin/test -r /home/verdaxis-prod/verdaxis/prod/be/.runtime-release.env
ExecStartPre=/usr/bin/test ! -e /home/verdaxis-prod/verdaxis/prod/be/.runtime-deploying
ExecStart=/home/verdaxis-prod/verdaxis/prod/be/venv/bin/python -m app.cli.refresh_news
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
