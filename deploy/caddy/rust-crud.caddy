# Import inside the site's route block. Arguments 0-5 are one independently
# approved upstream per Phase 2 route group; argument 6 is the single pre-auth
# quota authority (the Rust read service).
#
# Matchers are exact method and path pairs, not prefixes. A GET on a PATCH-only
# path, an unknown method, a HEAD request or the legacy entry adapters (W09 POST
# entries and W10 DELETE entries) find no handle here and answer from the
# site's own fallback. Canonical paths have no trailing slash, so a slash
# variant is also unmatched and the site answers it.
# Path parameters match any non-empty segment, as the router's converter does;
# a malformed value is the route's own 422, not a routing decision.
#
# One upstream per group, no fallback and no passive-health quarantine: a
# stopped Rust service answers through its own upstream error.
#
# Decision 78: every `/api/admin/` request is counted once, before the route
# match, by the one Rust authority. The authority admits with 204 and refuses
# with the shared 429. If the authority is unreachable the pool fails closed
# with 503; only a CORS OPTIONS preflight is uncounted, other methods still
# consume the shared admin quota.
#
# The gate copies the request with `method GET` and rewrites only that copy.
# Caddy drops the body from a copy changed to GET, so an admin write body
# still reaches its owner; the clone also keeps the gate from observing the
# original method and URI, which the authority does not need.
(verdaxis_rust_crud) {
	# Never trust a quota mark supplied by an external client.
	request_header -X-Verdaxis-Preauth-Counted
	@admin_pre_auth {
		path /api/admin/*
		not {
			method OPTIONS
			header Origin *
			header Access-Control-Request-Method *
		}
	}
	reverse_proxy @admin_pre_auth {args[6]} {
		method GET
		rewrite /internal/admin-preauth
		lb_policy first
		lb_try_duration 2s
		lb_try_interval 250ms
		header_up X-Forwarded-For {client_ip}
		@counted {
			status 204
			header X-Verdaxis-Preauth-Counted 1
		}
		handle_response @counted {
			# Copy nothing: the authority has no headers to forward. Mark the
			# request so the Rust route does not charge the same request twice.
			request_header X-Verdaxis-Preauth-Counted 1
		}
		@unmarked status 2xx
		handle_response @unmarked {
			respond "Quota authority did not acknowledge admission" 503
		}
		@unavailable 404
		handle_response @unavailable {
			# The authority answers 404 only while it starts; a stopped
			# authority fails closed through the dial error.
			request_header -X-Verdaxis-Preauth-Counted
		}
	}
	@rust_crud_notifications_get {
		method GET
		path_regexp ^/api/notifications(/unread-count)?$
	}
	handle @rust_crud_notifications_get {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_notifications_write {
		method PATCH
		path_regexp ^/api/notifications/(read-all|[^/]+/read)$
	}
	handle @rust_crud_notifications_write {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_preferences_get {
		method GET
		path /api/users/me/preferences
	}
	handle @rust_crud_preferences_get {
		reverse_proxy {args[1]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_preferences_put {
		method PUT
		path_regexp ^/api/users/me/preferences/[^/]+$
	}
	handle @rust_crud_preferences_put {
		reverse_proxy {args[1]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	# Feedback is the one pre-auth counted group. F01 POST and F02 GET share
	# this group argument so they move together.
	@rust_crud_feedback_post {
		method POST
		path /api/feedback
	}
	handle @rust_crud_feedback_post {
		reverse_proxy {args[2]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_feedback_admin {
		method GET
		path /api/admin/feedback
	}
	handle @rust_crud_feedback_admin {
		reverse_proxy {args[2]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	# W09 POST entries and W10 DELETE entries are not matched: the legacy
	# adapters have no handle here and the site answers them.
	@rust_crud_watchlists_get {
		method GET
		path_regexp ^/api/watchlists(/[^/]+(/events)?)?$
	}
	handle @rust_crud_watchlists_get {
		reverse_proxy {args[3]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_watchlists_post {
		method POST
		path_regexp ^/api/watchlists(/me|/[^/]+/targets)?$
	}
	handle @rust_crud_watchlists_post {
		reverse_proxy {args[3]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_watchlists_patch {
		method PATCH
		path_regexp ^/api/watchlists/[^/]+/events/[^/]+$
	}
	handle @rust_crud_watchlists_patch {
		reverse_proxy {args[3]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_watchlists_delete {
		method DELETE
		path_regexp ^/api/watchlists/[^/]+(/targets/[^/]+)?$
	}
	handle @rust_crud_watchlists_delete {
		reverse_proxy {args[3]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_alerts_get {
		method GET
		path /api/alerts
	}
	handle @rust_crud_alerts_get {
		reverse_proxy {args[4]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_alerts_post {
		method POST
		path /api/alerts
	}
	handle @rust_crud_alerts_post {
		reverse_proxy {args[4]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_alerts_delete {
		method DELETE
		path_regexp ^/api/alerts/[^/]+$
	}
	handle @rust_crud_alerts_delete {
		reverse_proxy {args[4]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	# R05 resolves a public code and is the only referral route without a
	# bearer. It moves with its group; Caddy adds no authentication.
	@rust_crud_referrals_get {
		method GET
		path_regexp ^/api/referrals/(my-referrals|leaderboard|resolve/[^/]+)$
	}
	handle @rust_crud_referrals_get {
		reverse_proxy {args[5]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_crud_referrals_post {
		method POST
		path_regexp ^/api/referrals/(my-code|invite)$
	}
	handle @rust_crud_referrals_post {
		reverse_proxy {args[5]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
}
