# Import inside the existing site's route block, before its Python fallback.
# Arguments 0-4 are one independently approved upstream per group. Argument 5
# is the environment's Python upstream: every read group tries its group
# upstream first, then Python, so a stopped Rust service does not return 502.
# For rollback, change only that group's argument back to Python. Do not change
# the site's fallback.
#
# lb_policy first keeps the reviewed order. A refused connection is a dial
# error before any request bytes are sent; Caddy 2.11 always retries it, while
# a non-GET request is not retried after a connection succeeded (reverseproxy.go
# tryAgain and httptransport.go DialError). Passive health remembers the
# failure, so later requests choose Python directly instead of redialing Rust.
(verdaxis_rust_public) {
	@rust_simple {
		method GET
		path_regexp simple ^/api/(ports(/[^/]+)?|catalog/(products|delivery-points)|news)/?$
	}
	handle @rust_simple {
		reverse_proxy {args[0]} {args[5]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 30s
			max_fails 1
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_orderbook {
		method GET
		path /api/orderbook /api/orderbook/ /api/orderbook/snapshot /api/orderbook/snapshot/ /api/orderbook/bids /api/orderbook/bids/ /api/orderbook/asks /api/orderbook/asks/ /api/orderbook/with-ci /api/orderbook/with-ci/ /api/orderbook/aggregated /api/orderbook/aggregated/ /api/orderbook/product-counts /api/orderbook/product-counts/ /api/orderbook/map-summary /api/orderbook/map-summary/ /api/orderbook/map-summary/compact /api/orderbook/map-summary/compact/ /api/orderbook/products /api/orderbook/products/ /api/orderbook/regions /api/orderbook/regions/ /api/orderbook/fuel-types /api/orderbook/fuel-types/ /api/listings /api/listings/
	}
	handle @rust_orderbook {
		reverse_proxy {args[1]} {args[5]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 30s
			max_fails 1
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_prices {
		method GET
		path /api/prices /api/prices/ /api/prices/reference /api/prices/reference/ /api/prices/reference/export /api/prices/reference/export/ /api/trade-tape /api/trade-tape/
	}
	handle @rust_prices {
		reverse_proxy {args[2]} {args[5]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 30s
			max_fails 1
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_curves {
		method GET
		path /api/curves/forward /api/curves/forward/ /api/curves/forward/export /api/curves/forward/export/ /api/curves/forward/table /api/curves/forward/table/ /api/curves/forward/slice /api/curves/forward/slice/ /api/curves/forward/board /api/curves/forward/board/
	}
	handle @rust_curves {
		reverse_proxy {args[3]} {args[5]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 30s
			max_fails 1
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	# MCP carries writes (POST, DELETE). It keeps one upstream: a request whose
	# connection succeeded must never be replayed to a second server, and
	# production keeps MCP on Python regardless.
	@rust_mcp {
		method GET POST DELETE
		path /mcp
	}
	handle @rust_mcp {
		reverse_proxy {args[4]} {
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
}
