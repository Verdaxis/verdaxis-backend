# Import inside the site's route block.
# Argument 0 is the Rust upstream. One upstream, no fallback and no lb_try:
# a stopped Rust service answers through its own upstream error.
#
# One switch with the Rust release switch OFFBOARDING_ENABLED: the two
# matchers below own exactly the four individual offboarding operations.
#   POST /api/auth/admin/users/{user_id}/offboard
#   GET  /api/auth/admin/users/{user_id}/offboarding-preview
#   GET  /api/auth/admin/users/{user_id}/offboarding-trades
#   POST /api/auth/admin/trades/{trade_id}/reassign-responsible
# Disabled is this import absent: no handle matches and the site's own
# fallback answers 404. While the Rust switch is off, the Rust service has
# none of these routes either and answers 404. Enable the Rust switch and
# this import together.
#
# Matchers are exact method and path pairs and match case-sensitively. An
# identifier matches any non-empty segment; a malformed identifier is the
# route's own refusal. HEAD, OPTIONS, another method, a trailing slash and a
# longer or shorter path find no handle here.
#
# The Rust routes charge the shared /api/admin/ client quota themselves, so
# the client address is forwarded.
(verdaxis_rust_offboarding) {
	@rust_offboarding_get {
		method GET
		path_regexp ^/api/auth/admin/users/[^/]+/(offboarding-preview|offboarding-trades)$
	}
	handle @rust_offboarding_get {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			transport http {
				keepalive off
			}
		}
	}
	@rust_offboarding_post {
		method POST
		path_regexp ^/api/auth/admin/(users/[^/]+/offboard|trades/[^/]+/reassign-responsible)$
	}
	handle @rust_offboarding_post {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			transport http {
				keepalive off
			}
		}
	}
}
