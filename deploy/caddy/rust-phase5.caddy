# Import inside the site's route block, beside the import of the first read
# groups. Argument 0 is the one Rust upstream for every Phase 5 read route.
# One upstream, no fallback: a stopped Rust service answers through its own
# upstream error.
#
# One switch: the three matchers below move together. Removing this import
# stops every handle from matching and the site's own fallback answers.
#
# Matchers are exact method and path pairs, not prefixes, and match paths
# case-sensitively:
# - the six public reads take GET on the path with or without a trailing
#   slash, because the Rust service redirects the slash form itself;
# - the four authenticated routes take their one method on the canonical path
#   only. The Rust service does not redirect a slash variant of an
#   authenticated route, so that variant finds no handle here;
# - a vessel id matches any non-empty segment, as the router's converter
#   does; a malformed id is the route's own refusal, not a routing decision;
# - HEAD, OPTIONS, a wrong method, a longer or shorter path and every other
#   route find no handle here.
#
(verdaxis_rust_phase5) {
	@rust_phase5_public {
		method GET
		path_regexp ^/api/(benchmarks|availability|demand|fleet-intelligence|producers|compliance/fuels)/?$
	}
	handle @rust_phase5_public {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_phase5_compliance_get {
		method GET
		path_regexp ^/api/compliance/(fleet|vessels/[^/]+/score)$
	}
	handle @rust_phase5_compliance_get {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
	@rust_phase5_compliance_post {
		method POST
		path_regexp ^/api/compliance/(pricing-overlay|scenario)$
	}
	handle @rust_phase5_compliance_post {
		reverse_proxy {args[0]} {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				keepalive off
			}
		}
	}
}
