# Import inside the site's route block.
# Argument 0 is the Rust upstream; one upstream, no fallback. Only the exact
# path and GET/HEAD/OPTIONS move.
(verdaxis_rust_abilities) {
	@rust_abilities {
		method GET HEAD OPTIONS
		path_regexp ^/api/auth/me/abilities$
	}
	handle @rust_abilities {
		reverse_proxy {args[0]} {
			header_up X-Forwarded-For {client_ip}
			transport http {
				keepalive off
			}
		}
	}
}
