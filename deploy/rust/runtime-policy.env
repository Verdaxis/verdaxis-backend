# Purpose-bound runtime policy (Phase 10 Task 9). One row per key a Rust purpose
# receives: purpose<TAB>key<TAB>status<TAB>delivery. `ops prepare-runtime` builds
# each purpose's file from the deployed .env with exactly these keys; a key not
# listed for a purpose never reaches it. The full .env is never copied.
#
# status:   required (missing refuses the projection) | optional (absent: not
#           projected; the consumer applies its documented default or refusal)
#           | derived (computed by the projection, not read from .env as is)
# delivery: runtime.env (serve, 0600) | jobs/<name>.env (0600) |
#           credential:<name> (systemd credential, never an env key) |
#           invocation (passed to that one process only)
#
# Every purpose also receives ENVIRONMENT and RELEASE_SHA (derived: checked
# against the release) and, for jobs, monitors and migrate, DEPLOY_STATE_DIR.

# serve: the reviewed HTTP credential set (scripts/prepare_rust_runtime.py today)
serve	ENVIRONMENT	derived	runtime.env
serve	RELEASE_SHA	derived	runtime.env
serve	MIGRATION_REVISION	derived	runtime.env
serve	DATABASE_URL	required	runtime.env
serve	DB_SESSION_TIME_ZONE	derived	runtime.env
serve	READ_ADMISSION_SLOTS	optional	runtime.env
serve	KYC_EXECUTION_GATE_ENABLED	optional	runtime.env
serve	ALLOWED_HOSTS	derived	runtime.env
serve	JWT_SECRET	required	runtime.env
serve	JWT_SECRET_PREVIOUS	optional	runtime.env
serve	JWT_ISSUER	required	runtime.env
serve	JWT_AUDIENCE	required	runtime.env
serve	FRONTEND_URL	required	runtime.env
serve	EMAIL_FROM	required	runtime.env
serve	RESEND_API_KEY	required	runtime.env
serve	AUTH_DOMAIN_DATASETS_FILE	derived	runtime.env
serve	MONITOR_TOKEN	optional	runtime.env
serve	SELLER_FEE_PILOT_PER_MT_USD	optional	runtime.env
serve	SELLER_FEE_PROFESSIONAL_PER_MT_USD	optional	runtime.env
serve	UMAMI_BASE_URL	optional	runtime.env
serve	UMAMI_WEBSITE_ID	optional	runtime.env
serve	UMAMI_API_USERNAME	optional	runtime.env
serve	UMAMI_API_PASSWORD	optional	runtime.env
serve	UMAMI_ENABLED	derived	runtime.env
serve	SYSTEM_STATUS	optional	runtime.env
serve	SYSTEM_STATUS_MESSAGE	optional	runtime.env
serve	AUTO_MATCHING_ENABLED	optional	runtime.env
serve	MARKET_SUPPORT_ENABLED	optional	runtime.env
serve	MARKET_SUPPORT_MAX_TTL_HOURS	optional	runtime.env
serve	MARKET_SUPPORT_CONTEXT_TTL_MINUTES	optional	runtime.env
serve	MARKET_SUPPORT_CONSENT_VERSION	optional	runtime.env
serve	MARKET_SUPPORT_CONSENT_REFERENCE	optional	runtime.env
serve	MARKET_SUPPORT_BOOTSTRAP_ADMIN_USER_IDS	optional	runtime.env
serve	kyc-document-keys	optional	credential:kyc-document-keys

# Jobs: each gets its own file and its own pool; no JWT key, no migrator key.
job.news	DATABASE_URL	required	jobs/news.env
job.news	GEMINI_API_KEY	optional	jobs/news.env
job.news	WEBZ_API_TOKEN	optional	jobs/news.env
job.news	WEBZ_API_URL	optional	jobs/news.env
job.news	WEBZ_API_TIMEOUT_SECONDS	optional	jobs/news.env
job.auth-maintenance	DATABASE_URL	required	jobs/auth-maintenance.env
job.auth-maintenance	RESEND_API_KEY	required	jobs/auth-maintenance.env
job.auth-maintenance	EMAIL_FROM	required	jobs/auth-maintenance.env
job.auth-maintenance	FRONTEND_URL	required	jobs/auth-maintenance.env
job.reminders	DATABASE_URL	required	jobs/reminders.env
job.reminders	RESEND_API_KEY	required	jobs/reminders.env
job.reminders	EMAIL_FROM	required	jobs/reminders.env
job.reminders	FRONTEND_URL	required	jobs/reminders.env
job.kyc-notices	DATABASE_URL	required	jobs/kyc-notices.env
job.kyc-notices	RESEND_API_KEY	required	jobs/kyc-notices.env
job.kyc-notices	EMAIL_FROM	required	jobs/kyc-notices.env
job.kyc-notices	FRONTEND_URL	required	jobs/kyc-notices.env
job.kyc-notices	KYC_EXECUTION_GATE_ENABLED	optional	jobs/kyc-notices.env
job.kyc-notices	KYC_GRACE_NOTICE_LIVE_SEND_AUTHORIZED	optional	jobs/kyc-notices.env
job.prune-analytics	DATABASE_URL	required	jobs/prune-analytics.env

# Monitors: Telegram delivery only where the monitor sends.
monitor.onboarding	DATABASE_URL	required	jobs/monitor-onboarding.env
monitor.onboarding	TELEGRAM_BOT_TOKEN	optional	jobs/monitor-onboarding.env
monitor.onboarding	TELEGRAM_CHAT_ID	optional	jobs/monitor-onboarding.env
monitor.onboarding	TELEGRAM_API_BASE	optional	jobs/monitor-onboarding.env
monitor.alert	TELEGRAM_BOT_TOKEN	optional	jobs/monitor-alert.env
monitor.alert	TELEGRAM_CHAT_ID	optional	jobs/monitor-alert.env
monitor.alert	TELEGRAM_API_BASE	optional	jobs/monitor-alert.env

# migrate: the migrator URL exists only in this one invocation.
migrate	MIGRATOR_DATABASE_URL	required	invocation
