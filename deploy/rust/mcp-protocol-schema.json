      "JSONRPCResponse": {
        "description": "A successful (non-error) response to a request.\n\nNamed `JSONRPCResultResponse` in the 2025-11-25+ schemas; the SDK keeps the original name.",
        "properties": {
          "jsonrpc": {
            "const": "2.0",
            "title": "Jsonrpc",
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer"
