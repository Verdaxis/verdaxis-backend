# Test-only derivative of the repository Dockerfile. Never deploy or push.
FROM docker.io/library/python:3.12-slim@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt constraints.txt ./
RUN pip install --no-cache-dir -r requirements.txt -c constraints.txt \
    && pip check \
    && pip freeze --all > /phase0-packages.txt

# Source is supplied separately by a test-only runner, not baked from a checkout
# containing secrets or work/. No listening service is started by this image.
CMD ["python", "--version"]
