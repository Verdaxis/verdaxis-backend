          "users.pending_approval_email_payload": "jsonb nullable",
          "users.pending_approval_email_retry_at": "timestamptz nullable"
        }
      },
      "rules": {
        "claim_seconds": 300,
        "failure_defer_seconds": 3600,
        "batch_default": 20,
        "batch_max": 100,
        "idempotency_key": "account-approval/{transition_id}",
        "finalize_match": [
          "user_id",
          "transition_id",
          "claim_until"
        ],
        "payload": "freeze at approval; never rebuild on retry; preserve retained optional field omission",
        "eligibility": "APPROVED, email verified, nonadmin",
        "transaction": "all helpers borrow caller connection; no commit; claim committed by owner before bounded send without user lock",
        "reapproval": "new transition; old finalization cannot clear newer claim",
        "notification": "one bounded send per claim; no new timer; uncertain send not exactly-once guaranteed"
      },
