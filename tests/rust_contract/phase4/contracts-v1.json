          "declaration": "pub fn eligibility(policy: &KycPolicy, party: &KycParty, grace: Option<&Grace>, now: DateTime<Utc>) -> KycEligibility",
          "sha256": "c27f64dc891b9ec1064529f5bdd275e3855a12044a6296b5bf5da58c79b13673"
        },
        {
          "declaration": "pub fn bind_eligibility_sql(builder: &mut QueryBuilder<Postgres>, policy: &KycPolicy, party: KycSqlParty, now: DateTime<Utc>)",
          "sha256": "87a7b1a8a9ce011b83ac52a0765bb6897c7b2f44273487ca22999a2e657aceb9"
        }
      ],
      "schemas": {
        "KycPolicy": {
          "execution_gate_enabled": "bool; runtime Config.kyc_execution_gate_enabled only"
        },
        "KycParty": {
          "user_id": "Uuid",
          "organization_id": "Option<Uuid>",
          "kyc_organization_id": "Option<Uuid>",
          "kyc_status": "Pending|Submitted|Approved|Rejected"
        },
        "Grace": {
          "user_id": "Uuid",
          "organization_id": "Uuid",
          "expires_at": "DateTime<Utc>"
        },
        "KycEligibility": {
          "eligible": "bool",
          "reason": "KYC_NOT_ENFORCED|KYC_APPROVED|KYC_REJECTED|KYC_GRACE|KYC_REQUIRED",
          "grace_expires_at": "Option<DateTime<Utc>>"
        },
        "KycSqlParty": {
          "user_alias": "closed developer-owned alias",
          "organization_alias": "closed developer-owned alias"
        },
        "profile_not_applicable": "separate presentation state; never market eligibility",
        "KycSqlBinding": {
          "user": "u",
          "grace": "g",
          "binds": [
            "execution_gate_enabled bool",
            "now timestamptz"
          ],
          "strict_sql": "u.kyc_status <> 'REJECTED' AND ((u.kyc_status = 'APPROVED' AND u.kyc_organization_id = u.organization_id) OR EXISTS (SELECT 1 FROM kyc_execution_grace g WHERE g.user_id = u.id AND g.organization_id = u.organization_id AND g.expires_at > $now))",
          "advisory_sql": "u.kyc_status <> 'REJECTED' AND (u.kyc_organization_id IS NULL OR u.kyc_organization_id = u.organization_id)",
          "combined": "(NOT $enabled AND advisory_sql) OR ($enabled AND strict_sql)"
        }
      },
      "rules": {
        "switch": "one runtime switch; no route copies",
        "enabled": "current organization required; bound approved or current unexpired organization-bound grace; rejection always blocks; cross-organization grace never applies",
        "disabled": "advisory: rejection or review bound to another organization blocks; otherwise eligible with KYC_NOT_ENFORCED",
        "grace_expiry": "now < expires_at; equality refuses",
        "sql": "same decision truth table and bound switch/now; reuse market visibility; no untrusted SQL identifiers",
        "authority": "grace SELECT-only; no fake KYC",
        "evidence": "vault has no provider dependency; encrypted rows and history retained"
      },
