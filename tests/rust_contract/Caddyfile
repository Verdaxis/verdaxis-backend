{
	admin off
	auto_https off
}
import {$ROUTE_SNIPPET}
import {$CRUD_SNIPPET}
http://:{$CADDY_PORT} {
	bind 127.0.0.1
	route {
		import verdaxis_rust_public {$SIMPLE_UPSTREAM} {$ORDERBOOK_UPSTREAM} {$PRICES_UPSTREAM} {$CURVES_UPSTREAM} {$MCP_UPSTREAM} {$PYTHON_UPSTREAM}
		import verdaxis_rust_crud {$NOTIFICATIONS_UPSTREAM} {$PREFERENCES_UPSTREAM} {$FEEDBACK_UPSTREAM} {$WATCHLISTS_UPSTREAM} {$ALERTS_UPSTREAM} {$REFERRALS_UPSTREAM} {$PREAUTH_UPSTREAM} {$PYTHON_UPSTREAM}
		handle {
			reverse_proxy {$PYTHON_UPSTREAM} {
				flush_interval -1
				transport http {
					keepalive off
				}
			}
		}
	}
}
