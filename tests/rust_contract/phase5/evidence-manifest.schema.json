{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 5 neutral evidence manifest",
  "type": "object",
  "required": [
    "schema_version",
    "backend_sha",
    "frontend_sha",
    "schema_revision",
    "route_ids",
    "required_scenarios",
    "results",
    "regression_suites",
    "bounds_version",
    "routing_matrix_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "backend_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frontend_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "schema_revision": {"type": "string", "minLength": 1},
    "route_ids": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(M0[1-5]|C0[1-5])$"}
    },
    "required_scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario", "test_identifier", "status", "source_sha"],
        "additionalProperties": false,
        "properties": {
          "scenario": {"type": "string", "minLength": 1},
          "test_identifier": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL"]},
          "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "regression_suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bounds_version": {"type": "string", "minLength": 1},
    "routing_matrix_version": {"type": "string", "minLength": 1}
  }
}
