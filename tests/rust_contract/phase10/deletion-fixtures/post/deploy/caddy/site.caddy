# Fixture site: post-deletion state. No upstream points at Python: the
# retired routes answer 404 directly and every remaining handle proxies the
# Rust service. The Phase 7 matchers keep their exact 404 ownership.
api.fixture.example {
	route {
		@phase7_rfq_create {
			method POST OPTIONS
			path /api/rfq
		}
		handle @phase7_rfq_create {
			respond 404
		}
		@phase7_rfq_read {
			method GET HEAD OPTIONS
			path_regexp phase7_rfq_read ^/api/rfq/[^/]+$
		}
		handle @phase7_rfq_read {
			respond 404
		}
		@retired_activity {
			method GET OPTIONS
			path /api/stream/activity
		}
		handle @retired_activity {
			respond 404
		}
		@retired_ai_chat {
			method POST OPTIONS
			path /api/ai/chat
		}
		handle @retired_ai_chat {
			respond 404
		}
		@retired_mcp {
			method POST OPTIONS
			path /mcp
		}
		handle @retired_mcp {
			respond 404
		}
		@retired_admin {
			path /admin /admin/*
		}
		handle @retired_admin {
			respond 404
		}
		handle {
			reverse_proxy 127.0.0.1:8100 {
				flush_interval -1
			}
		}
	}
}
