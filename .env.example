# Database
ENVIRONMENT=development
# Deploy writes a gitignored .runtime-release.env atomically. Development and
# test may use their named placeholder; staging/production require 40 hex.
RELEASE_SHA=development
DATABASE_HOST=verdaxis-db
DATABASE_PORT=5432
# Exact deployed identities are production verdaxis/verdaxis_app and staging
# verdaxis_staging/verdaxis_app_staging. Both must be least-privilege LOGIN roles.
DATABASE_NAME=verdaxis
DATABASE_USER=verdaxis_app
DATABASE_PASSWORD=CHANGE_ME

# Required in staging/production and forbidden from sharing the app role.
# Exact migrators are verdaxis_migrator and verdaxis_migrator_staging.
# App and migrator URLs require explicit non-placeholder passwords; empty or
# decoded whitespace-only values (including percent-encoded whitespace) fail.
# Neither URL may contain query parameters.
MIGRATOR_DATABASE_URL=

# SQLAlchemy async pool (each uvicorn worker gets this pool). For PostgreSQL
# max_connections=100, exactly prod + staging share the cluster and reserve at
# least 20 immutable maintenance connections. Deployed config may not undercount.
# connections for maintenance: 2 services * 4 workers * (2 + 1) + 20 = 44 <= 100.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
UVICORN_WORKERS=4
DB_SERVICE_COUNT=2
DB_MAX_CONNECTIONS=100
DB_RESERVED_CONNECTIONS=20

# Runtime role/session limits (milliseconds). Migrator values are separate
# and longer-lived, but remain bounded.
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
MIGRATOR_STATEMENT_TIMEOUT_MS=300000
MIGRATOR_LOCK_TIMEOUT_MS=30000
MIGRATOR_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=300000

# KYC upload bounds; requests over either limit return HTTP 413 before analysis.
KYC_MAX_FILE_BYTES=10485760
KYC_MAX_TOTAL_BYTES=20971520
HEALTH_READINESS_TIMEOUT_SECONDS=2

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_SECRET_PREVIOUS=
JWT_ALGORITHM=HS256
# Required, unique per deployed environment; never reuse staging values in prod.
ENVIRONMENT=staging
JWT_ISSUER=CHANGE_ME_STAGING_ISSUER
JWT_AUDIENCE=CHANGE_ME_STAGING_AUDIENCE

# Admin UI — generate a separate secret
ENABLE_SQLADMIN=false
ADMIN_SESSION_SECRET=CHANGE_ME_MIN_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Google AI (backend-only, never expose to frontend)
GEMINI_API_KEY=

# Server
project_name=Verdaxis
FRONTEND_URL=https://app.verdaxis.exchange
# Credentialed CORS origins are a closed set derived from ENVIRONMENT in app/config.py.

# Auth bypass MUST be false in production
ENABLE_AUTH_BYPASS=false

# Optional self-hosted Umami behavioral analytics. Leave disabled or empty to
# keep the API fully operational without analytics.
ANALYTICS_ENABLED=false

# Assisted supplier listings (disabled until commercial approval and staging sign-off)
MARKET_SUPPORT_ENABLED=false
MARKET_SUPPORT_MAX_TTL_HOURS=168
MARKET_SUPPORT_BOOTSTRAP_ADMIN_USER_IDS=
UMAMI_BASE_URL=https://analytics.example.com
UMAMI_WEBSITE_ID=
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
ANALYTICS_REQUEST_TIMEOUT_SECONDS=2
