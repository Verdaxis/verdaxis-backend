# Database
DATABASE_HOST=verdaxis-db
DATABASE_PORT=5432
DATABASE_NAME=verdaxis
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ALGORITHM=HS256

# Admin UI — generate a separate secret
ADMIN_SESSION_SECRET=CHANGE_ME_MIN_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Google AI (backend-only, never expose to frontend)
GEMINI_API_KEY=

# Server
PYTHONPATH=.
project_name=Verdaxis

# Auth bypass MUST be false in production
ENABLE_AUTH_BYPASS=false
