# Database
DATABASE_HOST=verdaxis-db
DATABASE_PORT=5432
DATABASE_NAME=verdaxis
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# SQLAlchemy async pool (each uvicorn worker gets this pool). For PostgreSQL
# max_connections=100, the defaults reserve 20 connections for migrations,
# admin/maintenance clients, and other processes: 4 * (5 + 2) + 20 = 48 <= 100.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_WORKERS=4
DB_MAX_CONNECTIONS=100
DB_RESERVED_CONNECTIONS=20

# KYC upload bounds; requests over either limit return HTTP 413 before analysis.
KYC_MAX_FILE_BYTES=10485760
KYC_MAX_TOTAL_BYTES=20971520

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ALGORITHM=HS256

# Admin UI — generate a separate secret
ADMIN_SESSION_SECRET=CHANGE_ME_MIN_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Google AI (backend-only, never expose to frontend)
GEMINI_API_KEY=

# Server
PYTHONPATH=.
project_name=Verdaxis
FRONTEND_URL=https://app.verdaxis.exchange
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174","https://app.verdaxis.exchange","https://verdaxis-frontend.vercel.app","https://staging.verdaxis.exchange","https://verdaxis.exchange"]

# Auth bypass MUST be false in production
ENABLE_AUTH_BYPASS=false

# Optional self-hosted Umami behavioral analytics. Leave disabled or empty to
# keep the API fully operational without analytics.
ANALYTICS_ENABLED=false
UMAMI_BASE_URL=https://analytics.example.com
UMAMI_WEBSITE_ID=
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=
ANALYTICS_REQUEST_TIMEOUT_SECONDS=2
