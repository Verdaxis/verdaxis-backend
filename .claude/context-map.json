{
  "rules": [
    {
      "pattern": "api/.*|app/.*|src/routes/.*|.*router.*",
      "inject": ".codesight/routes.md"
    },
    {
      "pattern": "api/.*|app/.*|src/routes/.*|.*router.*",
      "inject": ".codesight/libs.md"
    },
    {
      "pattern": ".*schema.*|.*model.*|db/.*",
      "inject": ".codesight/schema.md"
    },
    {
      "pattern": ".*schema.*|.*model.*|db/.*",
      "inject": ".codesight/libs.md"
    },
    {
      "pattern": "src/components/.*|app/.*/components/.*|components/.*",
      "inject": ".codesight/libs.md"
    },
    {
      "pattern": ".*service.*|.*handler.*|.*controller.*|.*route.*|.*model.*|.*schema.*",
      "inject": ".codesight/libs.md"
    }
  ]
}
